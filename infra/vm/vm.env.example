# Настройки для setup.sh. Скопируйте в vm.env (он в .gitignore) и поправьте.
# Один и тот же файл подходит для обеих ролей: лишние для роли переменные игнорируются.

# --- Общее -----------------------------------------------------------------

# Пользователь, под которым заходим по SSH (root по SSH будет запрещён)
ADMIN_USER=mathew
# Публичный ключ для ADMIN_USER. Если пусто — берётся уже существующий
# ~ADMIN_USER/.ssh/authorized_keys, а если и его нет — /root/.ssh/authorized_keys
ADMIN_PUBKEY=""
# Кому ещё разрешён вход по SSH (AllowUsers). По умолчанию только ADMIN_USER
SSH_ALLOW_USERS=""

# Внутренняя сеть между ВМ и подсеть VPN-клиентов
LAN_NET=192.168.0.0/24
VPN_NET=10.161.0.0/24
# Откуда пускать на 22 порт. Сейчас VPN-шлюз маскарадит клиентов,
# поэтому на ВМ сайта они приходят с LAN-адреса шлюза, а на сам шлюз — из VPN_NET
SSH_ALLOW_FROM="$LAN_NET $VPN_NET"

TIMEZONE=Asia/Yekaterinburg
# Создать swap-файл такого размера, если swap нет. Пусто — не создавать
SWAP_SIZE=1G
JOURNAL_MAX=500M

# Интерфейсы определяются сами (публичный — по маршруту по умолчанию,
# внутренний — по адресу из LAN_NET). Задавайте, только если угадало неверно
PUB_IF=""
LAN_IF=""

# --- Роль vpn --------------------------------------------------------------

# Имя интерфейса = имя файла /etc/wireguard/<WG_IF>.conf.
# wg_deploy создаёт bay_srv; в дипломе фигурирует wg0 — сверьтесь с audit.sh
WG_IF=wg0
WG_PORT=5353
# Переезд: путь к серверному конфигу со старой машины. Тогда ключи сохранятся,
# и клиентам нужно поменять только Endpoint. Пусто — сгенерировать новый
WG_RESTORE_CONF=""
# Сколько клиентских конфигов сгенерировать (только для нового сервера)
WG_CLIENTS=5
# Какие сети клиент заворачивает в туннель (только для новых клиентских конфигов).
# По умолчанию — split tunnel: VPN, LAN и публичный IP сайта (чтобы админка
# открывалась по домену через VPN). Полный туннель, как в wg_deploy: "0.0.0.0/0"
WG_CLIENT_ALLOWED_IPS="$VPN_NET, $LAN_NET, 80.87.109.102/32"
# DNS в клиентском конфиге. Нужен только при полном туннеле
WG_CLIENT_DNS=""
# Публичный IP шлюза для Endpoint. Пусто — взять с публичного интерфейса
VPN_PUBLIC_IP=""
# Куда шлюз пропускает трафик клиентов наружу (через публичный интерфейс):
#   all  — куда угодно (нужно для старых клиентов с полным туннелем 0.0.0.0/0)
#   app  — только на APP_PUBLIC_IP (хватает для split tunnel)
#   none — только во внутреннюю сеть
WG_FORWARD_TO_INTERNET=all
APP_PUBLIC_IP=80.87.109.102

# --- Роль app --------------------------------------------------------------

REPO_URL=https://github.com/maksmaksonchik/wms-site.git
APP_DIR=/opt/wms-site
